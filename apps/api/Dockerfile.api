# syntax=docker/dockerfile:1

FROM golang:1.22-alpine AS builder
WORKDIR /src

# Install build dependencies
RUN apk add --no-cache ca-certificates tzdata

# Cache Go modules first
COPY apps/api/go.mod apps/api/go.sum ./apps/api/
WORKDIR /src/apps/api
RUN go mod download

# Build application
COPY apps/api ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/api-server ./cmd/server

FROM alpine:3.20 AS runtime
WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata

# Run as non-root
RUN addgroup -S app && adduser -S app -G app

COPY --from=builder /out/api-server /app/api-server
COPY apps/api/keys /app/keys

ENV SERVER_PORT=8080 \
    KAFKA_ENABLED=false \
    JWT_PRIVATE_KEY_PATH=/app/keys/jwt-private.pem \
    JWT_PUBLIC_KEY_PATH=/app/keys/jwt-public.pem

USER app
EXPOSE 8080

ENTRYPOINT ["/app/api-server"]
