# Server Configuration
SERVER_PORT=8080

# Database Configuration
DB_HOST=192.168.1.199
DB_PORT=3307
DB_USER=root
DB_PASSWORD=123456
DB_NAME=shipping

# JWT Configuration (ADR-008) - RS256 Algorithm
# Option 1: File paths (recommended for production)
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem

# Option 2: Inline PEM (for testing/containers)
# JWT_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

JWT_ISSUER=shipping-service
JWT_AUDIENCE=shipping-service
JWT_ACCESS_TOKEN_DURATION=15
JWT_REFRESH_TOKEN_DURATION=7

# CORS Configuration
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Kafka Configuration (optional)
# KAFKA_ENABLED=false
# KAFKA_BROKERS=localhost:9092
# KAFKA_CONSUMER_GROUP=shipping-service
# KAFKA_ORDER_TOPIC=order-events
# KAFKA_DLQ_TOPIC=shipping-service-dlq
